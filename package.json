{
  "name": "aptos-tools",
  "version": "1.0.0",
  "private": true,
  "description": "A suite of helpful Aptos blockchain tools",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "fmt": "pnpm format",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "deploy": "cd apps/web && pnpm run deploy"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "turbo": "^2.8.11"
  },
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
